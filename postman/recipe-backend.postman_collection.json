{
  "info": {
    "name": "Recipe Backend API",
    "description": "Postman collection for login, token reuse, and Recipe CRUD automation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Create Test User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"{{firstName}}\",\n  \"lastName\": \"{{lastName}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/recipeapi/users/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recipeapi",
                "users",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('firstName', 'Postman');",
                  "pm.environment.set('lastName', 'Test');",
                  "pm.environment.set('email', 'postman.user.' + Date.now() + '@example.com');",
                  "pm.environment.set('password', 'Password123!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create user returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.environment.set('token', jsonData.token);",
                  "pm.environment.set('userId', jsonData.id);",
                  "pm.environment.set('email', jsonData.email);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{email}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/recipeapi/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recipeapi",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.environment.set('token', jsonData.token);",
                  "pm.environment.set('userId', jsonData.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Recipe CRUD",
      "item": [
        {
          "name": "Create Recipe",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Recipe {{userId}}\",\n  \"description\": \"A recipe created from Postman tests.\",\n  \"servings\": 2,\n  \"time\": 15,\n  \"isPublished\": false,\n  \"userId\": {{userId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/recipeapi/recipes/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recipeapi",
                "recipes",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Recipe creation returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.environment.set('recipeId', jsonData.id);",
                  "pm.environment.set('recipeName', jsonData.name);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Recipe by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/recipeapi/recipes/{{recipeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recipeapi",
                "recipes",
                "{{recipeId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get recipe returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Requested recipe has correct id', function () {",
                  "    pm.expect(jsonData[0].id).to.eql(Number(pm.environment.get('recipeId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List Recipes For User",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/recipeapi/recipes/user/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recipeapi",
                "recipes",
                "user",
                "{{userId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('List recipes returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Response contains recipe Id', function () {",
                  "    pm.expect(jsonData.some(item => item.id === Number(pm.environment.get('recipeId')))).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Recipe",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Postman Recipe\",\n  \"description\": \"Updated by Postman automation.\",\n  \"servings\": 4,\n  \"time\": 30,\n  \"isPublished\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/recipeapi/recipes/{{recipeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recipeapi",
                "recipes",
                "{{recipeId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Update recipe returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Update response acknowledges success', function () {",
                  "    pm.expect(jsonData.message).to.include('updated successfully');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Recipe",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/recipeapi/recipes/{{recipeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recipeapi",
                "recipes",
                "{{recipeId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Delete recipe returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Delete response acknowledges success', function () {",
                  "    pm.expect(jsonData.message).to.include('deleted successfully');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
